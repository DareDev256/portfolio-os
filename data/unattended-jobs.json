{
  "_comment": "The jobs the SNAPSHOT LOG reports on. Until 2026-08-31 that panel was four hand-typed <div>s with frozen times — the page's single strongest proof of 'systems that run without me' was a mockup, on a page whose whole argument is that its numbers are measured. These are real launchd jobs; the generator reads when each last ran from its own log and reports only what it can see. A job that has not run recently simply does not appear, which is the honest failure: an empty log means nothing ran, not that the panel is broken.",
  "windowHours": 36,
  "jobs": [
    { "id": "daily-brief",            "label": "Morning brief compiled and sent", "source": "daily-brief · Discord",      "log": "~/.claude/logs/daily-brief.log" },
    { "id": "check-daily-rollup",     "label": "Agent rollup written",     "source": "check-daily-rollup",          "log": "~/.claude/logs/check-daily-rollup.out.log" },
    { "id": "branch-shepherd",        "label": "Branches swept for drift",        "source": "branch-shepherd",             "log": "~/.claude/logs/branch-shepherd.log" },
    { "id": "career-digest",          "label": "Career pipeline digested",        "source": "career-digest · Discord",     "log": "~/.claude/logs/career-digest.out.log" },
    { "id": "portfolio-traffic-radar","label": "Portfolio traffic swept",         "source": "portfolio-traffic-radar",     "log": "~/dev/utilities/passion-cron/logs/portfolio-traffic-radar.log" },
    { "id": "sandra-digest",          "label": "Household digest sent",           "source": "sandra-digest · Discord",     "log": "~/dev/utilities/passion-cron/logs/sandra-digest.log" },
    { "id": "life-rhythm",            "label": "Life-rhythm check ran",           "source": "life-rhythm",                 "log": "~/dev/utilities/passion-cron/logs/life-rhythm.log" },
    { "id": "drift-check",            "label": "Config drift reconciled",         "source": "drift-check",                 "log": "~/dev/utilities/passion-cron/logs/drift-check.log" }
  ]
}
