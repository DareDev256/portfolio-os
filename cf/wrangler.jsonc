{
  "name": "jamesdare-com",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "jamesdare.com", "custom_domain": true },
    { "pattern": "www.jamesdare.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/studio", "/studio/*", "/cv",
      "/passion", "/passion/*",
      "/book", "/os", "/os/*", "/coldopen", "/coldopen/*", "/monitor", "/monitor/*",
      "/about", "/work", "/media", "/connect", "/contact", "/settings", "/resume", "/terminal", "/services"
    ]
  }
}
