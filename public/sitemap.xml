<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Only real URLs. /services, /about, /work and /contact were Passion OS
       client-side routes; every one of them now rewrites to the landing page,
       so listing them would advertise five duplicates of a single document.

       Every <loc> is www, not the apex. The apex 307-redirects to www, so an
       apex <loc> asks Google to canonicalise onto a URL that does not serve the
       page — it splits ranking signal between two hosts instead of pooling it. -->
  <url>
    <loc>https://www.jamesdare.com/</loc>
    <lastmod>2026-08-30</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.jamesdare.com/os</loc>
    <lastmod>2026-08-30</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://www.jamesdare.com/coldopen</loc>
    <lastmod>2026-08-30</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://www.jamesdare.com/fandom-flow</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
